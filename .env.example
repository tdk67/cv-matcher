# OpenRouter API Key (required secret)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Frontend -> backend base URL. Leave unset for the default localhost:8000
# (single-container Docker sets it to http://localhost:8000). For Streamlit
# Community Cloud (frontend-only) set this as a Cloud secret to the public
# backend URL, e.g. https://cv-matcher.taskmind-ai.com
# API_BASE_URL=https://cv-matcher.taskmind-ai.com
