{
  "openrouter_api_key": "",
  "rag_model": "google/gemini-3.5-flash",
  "validation_model": "openai/gpt-4.1-nano",
  "chroma_persist_dir": "./.data/chromadb",
  "upload_dir": "./.data/uploads",
  "max_upload_size_mb": 50,
  "max_extracted_chars": 200000,
  "max_query_length": 500,
  "log_level": "INFO",
  "injection_threshold": 0.8,
  "min_match_score": 0.5,
  "max_retry_attempts": 3,
  "scan_fail_policy": "error",
  "tainted_policy": "exclude",
  "llm_max_retries": 3,
  "llm_retry_backoff_base": 1.0,
  "llm_retry_after_cap_seconds": 60,
  "pipeline_deadline_seconds": 100,
  "api_auth_token": "",
  "cors_origins": ["http://localhost:8501", "http://127.0.0.1:8501"],
  "rate_limits": {"query": 30, "evaluation_start": 2, "key_validate": 10, "upload": 10},
  "eval_file_path": ".data/evaluation/eval_results.json"
}